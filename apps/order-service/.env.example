PORT=3004
MONGO_URI=mongodb://localhost:27017/orders?replicaSet=rs0
RABBITMQ_URL=amqp://localhost:5672
REDIS_URL=redis://localhost:6379
PRODUCT_SERVICE_URL=http://localhost:3001
OUTBOX_POLL_MS=2000
JWT_SECRET=local-dev-jwt-secret
JWT_REFRESH_SECRET=local-dev-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Stripe (global / non-INR). Publishable key can also be set in admin → Payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Razorpay (recommended for INR). Key ID can also be set in admin → Payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Allow demo checkout without gateway keys (default in non-production).
PAYMENT_SIMULATE=true
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
COOKIE_SECURE=false
